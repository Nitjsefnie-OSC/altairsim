

                ;-----------------------------------------------------------------------
                ; HDIR.COM: list the host directory.
                ;
                ;       HDIR                    everything in hostdir
                ;       HDIR *.ASM              only what matches
                ;       HDIR SRC/               a subdirectory of hostdir
                ;
                ; Part of the altairsim Host Bridge. Assemble it in the machine:
                ;
                ;       ASM HDIR                -> HDIR.HEX
                ;       LOAD HDIR               -> HDIR.COM
                ;
                ; Revisions:
                ;       2026-07-14  First version.
                ;       2026-07-28  The long listing: size and date.
                ;
                ; HDIR prints each host name as it is on the host, in its own case and
                ; at its full length. R and W change a name to fit 8.3.
                ;
                ; HDIR makes no BDOS file calls. It uses the console and ports B0H and
                ; B1H only.
                ;-----------------------------------------------------------------------
                
 0100           	ORG	100H
                
                ;---- CP/M ------------------------------------------------------------
 0005 =         BDOS	EQU	0005H
 0080 =         TAIL	EQU	0080H		; the command tail: length, then the text.
                				; The CCP folds it to upper case. The board
                				; folds host names to match, and prints
                				; each name in its own case.
                
 0002 =         CONOUT	EQU	2		; E = char
 0009 =         PRSTR	EQU	9		; DE = string, ends in '$'
                
 0040 =         HNMAX	EQU	64		; a host name can be a path
 0020 =         IDMAX	EQU	32		; room for the board's signature
 0014 =         SZMAX	EQU	20		; a size in decimal (a uint64 is 20 digits)
 000C =         DTMAX	EQU	12		; room for a date ("MM/DD/YY")
 0008 =         SIZEW	EQU	8		; the width of the size column
 000D =         CR	EQU	0DH
 000A =         LF	EQU	0AH
                
                ;---- The Host Bridge (HB.INC has the full list) ----------------------
 00B0 =         HBCMD	EQU	0B0H		; OUT = command   IN = status
 00B1 =         HBDATA	EQU	0B1H		; data, both ways
                
 0008 =         HEOF	EQU	08H		; the listing has no more names
 0010 =         HERR	EQU	10H		; the last operation failed
                
 0000 =         CIDENT	EQU	0
 0009 =         CDIRL	EQU	9		; the long listing: name<0> size<0> date<0>
 0005 =         CDIRN	EQU	5		; the next entry. HEOF at the end.
 0007 =         CERROR	EQU	7
 0008 =         CRESET	EQU	8
                
                ;=======================================================================
                ; MAIN
                ;=======================================================================
 0100 318004    START:	LXI	SP,STACK
                
 0103 3E08      	MVI	A,CRESET	; one byte puts the board in a known
 0105 D3B0      	OUT	HBCMD		; state
                
 0107 CDD001    	CALL	IDENT		; exits if there is no board
 010A CD3A02    	CALL	PARSE		; the tail -> PAT. The board reads an
                				; empty pattern as `*`.
                
 010D 210000    	LXI	H,0		; a 16-bit count: a host directory can
 0110 223704    	SHLD	COUNT		; hold more than 255 files
                
 0113 3E09      	MVI	A,CDIRL
 0115 D3B0      	OUT	HBCMD
 0117 217203    	LXI	H,PAT
 011A CD0402    	CALL	SENDZ		; the NUL commits the command
                
                ;---- the listing loop -------------------------------------------------
 011D DBB0      DIR1:	IN	HBCMD
 011F E610      	ANI	HERR
 0121 C27B01    	JNZ	DIRBAD		; a bad pattern, or no such hostdir
                
 0124 DBB0      	IN	HBCMD
 0126 E608      	ANI	HEOF
 0128 C25401    	JNZ	DIRE		; no more names. With no matches at all,
                				; HDIR comes here on the first pass.
                
                ; Each entry is three strings: the name, the size ("<DIR>" for a folder,
                ; else a decimal byte count) and the date.
 012B 21B303    	LXI	H,NAME
 012E 0640      	MVI	B,HNMAX
 0130 CD0D02    	CALL	RECVZ
 0133 21F403    	LXI	H,SIZE
 0136 0614      	MVI	B,SZMAX
 0138 CD0D02    	CALL	RECVZ
 013B 210904    	LXI	H,DATE
 013E 060C      	MVI	B,DTMAX
 0140 CD0D02    	CALL	RECVZ
                
 0143 CD8101    	CALL	SHOW		; one line: <size>  <date>  <name>
                
 0146 2A3704    	LHLD	COUNT
 0149 23        	INX	H
 014A 223704    	SHLD	COUNT
                
 014D 3E05      	MVI	A,CDIRN
 014F D3B0      	OUT	HBCMD
 0151 C31D01    	JMP	DIR1
                
                ;---- the count --------------------------------------------------------
 0154 2A3704    DIRE:	LHLD	COUNT
 0157 7C        	MOV	A,H
 0158 B5        	ORA	L
 0159 CA7001    	JZ	DIRNON
                
 015C CD8802    	CALL	CRLF
 015F 2A3704    	LHLD	COUNT
 0162 CD9002    	CALL	PRDEC
 0165 114F03    	LXI	D,MFILES
 0168 0E09      	MVI	C,PRSTR
 016A CD0500    	CALL	BDOS
 016D C30000    	JMP	0		; warm boot
                
 0170 115903    DIRNON: LXI	D,MNONE
 0173 0E09      	MVI	C,PRSTR
 0175 CD0500    	CALL	BDOS
 0178 C30000    	JMP	0
                
 017B CD1A02    DIRBAD: CALL	REPERR
 017E C30000    	JMP	0
                
                ;-----------------------------------------------------------------------
                ; SHOW: print one entry as a line:  <size>  <date>  <name>
                ;
                ;       1792  07/14/26  R.COM
                ;      <DIR>  07/20/26  SRC/
                ;
                ; The size is right-justified in SIZEW columns. The date from the board
                ; is 8 characters. The name goes last, because it has no fixed length.
                ; A folder name ends in '/', and its size is "<DIR>".
                ;-----------------------------------------------------------------------
 0181 21F403    SHOW:	LXI	H,SIZE
 0184 0E08      	MVI	C,SIZEW
 0186 CD9E01    	CALL	RJUST
 0189 CDBC01    	CALL	SPC2		; two spaces between the columns
 018C 210904    	LXI	H,DATE
 018F CD7302    	CALL	PSTR
 0192 CDBC01    	CALL	SPC2
 0195 21B303    	LXI	H,NAME
 0198 CD7302    	CALL	PSTR
 019B C38802    	JMP	CRLF		; tail call: end the line
                
                ;-----------------------------------------------------------------------
                ; RJUST: print the string at HL right-justified in C columns. It prints
                ;        (C - length) spaces, then the string. A string of C characters
                ;        or more gets no spaces.
                ;-----------------------------------------------------------------------
 019E E5        RJUST:	PUSH	H
 019F CDC601    	CALL	STRLEN		; B = the length
 01A2 E1        	POP	H
 01A3 79        	MOV	A,C
 01A4 90        	SUB	B		; A = the number of spaces
 01A5 DAB901    	JC	RJ2		; wider than the field: no spaces
 01A8 CAB901    	JZ	RJ2
 01AB 47        	MOV	B,A
 01AC 3E20      RJ1:	MVI	A,' '
 01AE C5        	PUSH	B
 01AF E5        	PUSH	H
 01B0 CD8202    	CALL	PUTCH		; BDOS changes B and HL
 01B3 E1        	POP	H
 01B4 C1        	POP	B
 01B5 05        	DCR	B
 01B6 C2AC01    	JNZ	RJ1
 01B9 C37302    RJ2:	JMP	PSTR		; tail call: the string
                
                ;-----------------------------------------------------------------------
                ; SPC2: two spaces, the gap between columns.
                ;-----------------------------------------------------------------------
 01BC 3E20      SPC2:	MVI	A,' '
 01BE CD8202    	CALL	PUTCH
 01C1 3E20      	MVI	A,' '
 01C3 C38202    	JMP	PUTCH		; tail call
                
                ;-----------------------------------------------------------------------
                ; STRLEN: B = the length of the string at HL.
                ;-----------------------------------------------------------------------
 01C6 0600      STRLEN: MVI	B,0
 01C8 7E        SL1:	MOV	A,M
 01C9 B7        	ORA	A
 01CA C8        	RZ
 01CB 04        	INR	B
 01CC 23        	INX	H
 01CD C3C801    	JMP	SL1
                
                ;=======================================================================
                ; THE HOST BRIDGE
                ;=======================================================================
                
                ;-----------------------------------------------------------------------
                ; IDENT: check that the board is there before anything else.
                ;
                ; An IN from a port that no board decodes reads 0FFH, and 0FFH has HEOF
                ; and HERR set. Without this check, HDIR would print a host error or an
                ; empty listing.
                ;-----------------------------------------------------------------------
 01D0 3E00      IDENT:	MVI	A,CIDENT
 01D2 D3B0      	OUT	HBCMD
                
 01D4 211604    	LXI	H,IDBUF
 01D7 0620      	MVI	B,IDMAX
 01D9 DBB1      ID1:	IN	HBDATA
 01DB 77        	MOV	M,A
 01DC B7        	ORA	A
 01DD CAE701    	JZ	ID2		; the terminator
 01E0 23        	INX	H
 01E1 05        	DCR	B
 01E2 C2D901    	JNZ	ID1
 01E5 3600      	MVI	M,0		; no terminator: 0FFH, so no board
                
 01E7 211604    ID2:	LXI	H,IDBUF
 01EA 11C702    	LXI	D,IDWANT
 01ED 1A        ID3:	LDAX	D
 01EE B7        	ORA	A
 01EF C8        	RZ			; all of IDWANT matched. This is a prefix
                				; compare, so "... 2" matches too.
 01F0 BE        	CMP	M
 01F1 C2F901    	JNZ	IDBAD
 01F4 23        	INX	H
 01F5 13        	INX	D
 01F6 C3ED01    	JMP	ID3
                
 01F9 11DC02    IDBAD:	LXI	D,MNOHB
 01FC 0E09      	MVI	C,PRSTR
 01FE CD0500    	CALL	BDOS
 0201 C30000    	JMP	0
                
                ;-----------------------------------------------------------------------
                ; SENDZ: send the string at HL to the data port, with its NUL. The NUL
                ; commits the command.
                ;-----------------------------------------------------------------------
 0204 7E        SENDZ:	MOV	A,M
 0205 D3B1      	OUT	HBDATA
 0207 B7        	ORA	A
 0208 C8        	RZ
 0209 23        	INX	H
 020A C30402    	JMP	SENDZ
                
                ;-----------------------------------------------------------------------
                ; RECVZ: read a string from the data port into HL.
                ;        B = the room, with the NUL.
                ;-----------------------------------------------------------------------
 020D DBB1      RECVZ:	IN	HBDATA
 020F 77        	MOV	M,A
 0210 B7        	ORA	A
 0211 C8        	RZ
 0212 23        	INX	H
 0213 05        	DCR	B
 0214 C20D02    	JNZ	RECVZ
 0217 3600      	MVI	M,0		; no room left: cut the string here
 0219 C9        	RET
                
                ;-----------------------------------------------------------------------
                ; REPERR: print the board's error message, in the host's words.
                ;-----------------------------------------------------------------------
 021A 3E07      REPERR: MVI	A,CERROR
 021C D3B0      	OUT	HBCMD
 021E DBB1      	IN	HBDATA		; the code byte: skip it
                
 0220 114503    	LXI	D,MERR
 0223 0E09      	MVI	C,PRSTR
 0225 CD0500    	CALL	BDOS
                
 0228 DBB1      RPE1:	IN	HBDATA		; then the text, one character at a time
 022A B7        	ORA	A
 022B CA3702    	JZ	RPE2
 022E 5F        	MOV	E,A
 022F 0E02      	MVI	C,CONOUT
 0231 CD0500    	CALL	BDOS
 0234 C32802    	JMP	RPE1
                
 0237 C38802    RPE2:	JMP	CRLF		; tail call
                
                ;=======================================================================
                ; THE COMMAND TAIL
                ;=======================================================================
                
                ;-----------------------------------------------------------------------
                ; PARSE: the first word of the tail at 0080H -> PAT.
                ;
                ; HDIR does not use the CCP's FCB at 005CH. The CCP parses the word as
                ; 8.3, so `SRC/` would lose its slash.
                ;-----------------------------------------------------------------------
 023A 218000    PARSE:	LXI	H,TAIL
 023D 46        	MOV	B,M		; the length of the tail
 023E 23        	INX	H
                
 023F CD4B02    	CALL	SKIPSP
 0242 117203    	LXI	D,PAT
 0245 0E40      	MVI	C,HNMAX
 0247 CD5702    	CALL	TOKEN
 024A C9        	RET
                
 024B 78        SKIPSP: MOV	A,B
 024C B7        	ORA	A
 024D C8        	RZ
 024E 7E        	MOV	A,M
 024F FE20      	CPI	' '
 0251 C0        	RNZ
 0252 23        	INX	H
 0253 05        	DCR	B
 0254 C34B02    	JMP	SKIPSP
                
                ; Copy one word from (HL) to (DE), and end it with a NUL.
                ;   B = characters left in the tail   C = room at DE, with the NUL
                ; With no word, the result is an empty string.
 0257 79        TOKEN:	MOV	A,C
 0258 FE01      	CPI	1
 025A CA7002    	JZ	TOKEND
 025D 78        	MOV	A,B
 025E B7        	ORA	A
 025F CA7002    	JZ	TOKEND
 0262 7E        	MOV	A,M
 0263 FE20      	CPI	' '
 0265 CA7002    	JZ	TOKEND
 0268 12        	STAX	D
 0269 23        	INX	H
 026A 13        	INX	D
 026B 05        	DCR	B
 026C 0D        	DCR	C
 026D C35702    	JMP	TOKEN
 0270 AF        TOKEND: XRA	A
 0271 12        	STAX	D
 0272 C9        	RET
                
                ;=======================================================================
                ; MESSAGES TO THE USER
                ;=======================================================================
                
                ; PSTR: print the string at HL. HL is pushed across the BDOS call.
 0273 7E        PSTR:	MOV	A,M
 0274 B7        	ORA	A
 0275 C8        	RZ
 0276 E5        	PUSH	H
 0277 5F        	MOV	E,A
 0278 0E02      	MVI	C,CONOUT
 027A CD0500    	CALL	BDOS
 027D E1        	POP	H
 027E 23        	INX	H
 027F C37302    	JMP	PSTR
                
 0282 5F        PUTCH:	MOV	E,A
 0283 0E02      	MVI	C,CONOUT
 0285 C30500    	JMP	BDOS
                
 0288 114C03    CRLF:	LXI	D,MCRLF
 028B 0E09      	MVI	C,PRSTR
 028D C30500    	JMP	BDOS
                
                ;-----------------------------------------------------------------------
                ; PRDEC: print HL in decimal. The digits go into a buffer from the end.
                ;-----------------------------------------------------------------------
 0290 113F04    PRDEC:	LXI	D,NUMEND
 0293 3E24      	MVI	A,'$'
 0295 12        	STAX	D
 0296 1B        PD1:	DCX	D
 0297 CDA702    	CALL	DIV10		; HL = HL/10, A = the remainder
 029A C630      	ADI	'0'
 029C 12        	STAX	D
 029D 7C        	MOV	A,H
 029E B5        	ORA	L
 029F C29602    	JNZ	PD1
 02A2 0E09      	MVI	C,PRSTR
 02A4 C30500    	JMP	BDOS		; DE points at the first digit
                
                ; DIV10: HL = HL/10, A = the remainder, by repeated subtraction.
 02A7 C5        DIV10:	PUSH	B
 02A8 010000    	LXI	B,0
 02AB 7C        DV1:	MOV	A,H
 02AC B7        	ORA	A
 02AD C2B602    	JNZ	DV2
 02B0 7D        	MOV	A,L
 02B1 FE0A      	CPI	10
 02B3 DAC202    	JC	DV3
 02B6 7D        DV2:	MOV	A,L
 02B7 D60A      	SUI	10
 02B9 6F        	MOV	L,A
 02BA 7C        	MOV	A,H
 02BB DE00      	SBI	0
 02BD 67        	MOV	H,A
 02BE 03        	INX	B
 02BF C3AB02    	JMP	DV1
 02C2 7D        DV3:	MOV	A,L		; the remainder, before L changes
 02C3 60        	MOV	H,B
 02C4 69        	MOV	L,C
 02C5 C1        	POP	B
 02C6 C9        	RET
                
                ;=======================================================================
                ; DATA
                ;=======================================================================
 02C7 414C544149IDWANT: DB	'ALTAIRSIM HOSTBRIDGE',0
                
 02DC 0D0A484449MNOHB:	DB	CR,LF,'HDIR: no host bridge at B0H.',CR,LF
 02FC 5468697320	DB	'This machine has no `hostbridge` card in it, or it is at'
 0334 20616E6F74	DB	' another port.',CR,LF,'$'
                
 0345 484449523AMERR:	DB	'HDIR: $'
 034C 0D0A24    MCRLF:	DB	CR,LF,'$'
 034F 2066696C65MFILES: DB	' files.',CR,LF,'$'
 0359 484449523AMNONE:	DB	'HDIR: nothing matches.',CR,LF,'$'
                
                ;---- variables --------------------------------------------------------
 0372           PAT:	DS	HNMAX+1		; the pattern as typed. Empty = everything.
 03B3           NAME:	DS	HNMAX+1		; the name from the board. +1: RECVZ can
                				; write its NUL one byte past the count.
 03F4           SIZE:	DS	SZMAX+1		; its size as decimal text, or "<DIR>"
 0409           DATE:	DS	DTMAX+1		; its date, MM/DD/YY
 0416           IDBUF:	DS	IDMAX+1
 0437           COUNT:	DS	2		; the names printed
 0439           NUMBUF: DS	6
 043F           NUMEND: DS	1		; PRDEC ends here
                
 0440           	DS	64		; the stack
 0480 =         STACK	EQU	$
                
 0480           	END	START
